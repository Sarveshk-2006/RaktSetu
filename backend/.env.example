# ─────────────────────────────────────────────────────────────────────────────
# RAKTSETU Backend — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT:
# 1. Never commit real credentials, database passwords, or secret keys.
# 2. In production (ENVIRONMENT=production), AUTH_STRICT must be true,
#    SECRET_KEY must be a random 64-char string, and DATABASE_URL must be PostgreSQL.
# ─────────────────────────────────────────────────────────────────────────────

# Application Environment ('demo' | 'staging' | 'production')
ENVIRONMENT=demo
DEBUG=false

# Server Network Binding
HOST=0.0.0.0
PORT=8000

# Allowed Frontend Origins (JSON array of allowed origins)
# In production, specify your exact deployed frontend domains:
ALLOWED_ORIGINS=["http://localhost:5173","https://raktsetu.vercel.app","https://raktsetu-demo.vercel.app"]

# Database Connection String
# Development/Testing default: SQLite file
DATABASE_URL=sqlite:///./raktsetu.db
# Production example (PostgreSQL 16):
# DATABASE_URL=postgresql+psycopg2://user:strong_password@db-host:5432/raktsetu_prod
DATABASE_ECHO=false

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=generate-a-strong-random-64-character-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AUTH_STRICT: If true, all non-public endpoints strictly require JWT Bearer tokens
AUTH_STRICT=false

# Notification Boundary (Milestone 7)
# Provider options: 'mock' | 'twilio' | 'whatsapp'
NOTIFICATION_PROVIDER=mock
DEMO_MODE=true
WEBHOOK_SECRET=replace-with-cryptographic-webhook-secret-token

# Twilio Credentials (Required only when NOTIFICATION_PROVIDER=twilio and DEMO_MODE=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp Business Cloud API (Required only when NOTIFICATION_PROVIDER=whatsapp and DEMO_MODE=false)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Map Provider (Optional: MapTiler key for custom vector tiles; defaults to OpenStreetMap)
MAPTILER_API_KEY=
