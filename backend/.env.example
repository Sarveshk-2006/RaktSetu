# RAKTSETU Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
ENVIRONMENT=demo
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (PostgreSQL/PostGIS — not required for prototype)
DATABASE_URL=

# Cache (Redis — not required for prototype)
REDIS_URL=

# Optional: Map tile provider API key (falls back to OpenStreetMap if not set)
MAPTILER_API_KEY=
